# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Secure key for Google Maps JavaScript API, Places API, Geocoding API, and Routes API.
# AI Studio or user provides this via environment variables or Secrets panel.
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""

# RWANDA PAYMENT GATEWAY CONFIGURATION
# Supports: MTN Mobile Money Rwanda, Airtel Money Rwanda, Card (Visa/Mastercard), Ishema Wallet
# Store secret credentials only on the server, never expose in frontend code.
PAYMENT_PUBLIC_KEY=pk_test_ishema_rw_demo_pub_2026
PAYMENT_SECRET_KEY=sk_test_ishema_rw_demo_sec_994821
PAYMENT_API_URL=https://api.payments.ishema.rw/v1

